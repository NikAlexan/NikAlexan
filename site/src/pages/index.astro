---
import BaseLayout from "../layouts/BaseLayout.astro";
import MainPage from "../components/MainPage.astro";
import { getSite } from "../data/site";
import { getProfileJsonLd, homeAlternates } from "../data/seo";

const site = getSite("ru");
---

<BaseLayout
  title={site.meta.title}
  description={site.meta.description}
  locale={site.locale}
  ogImage={site.meta.ogImage}
  siteName={site.meta.siteName}
  alternates={homeAlternates}
  structuredData={getProfileJsonLd(site)}
>
  <MainPage site={site} />
</BaseLayout>
