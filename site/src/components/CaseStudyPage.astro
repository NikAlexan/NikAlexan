---
import MobileMenu from "./MobileMenu.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import { Code } from "astro:components";

const { caseStudy, site } = Astro.props;

const navItems = site.locale === "ru"
  ? [
      { label: "ОБЗОР", href: "#overview" },
      { label: "ЗАДАЧА", href: "#challenge" },
      { label: "СТЕК", href: "#stack" },
      { label: "ИТОГ", href: "#outcome" }
    ]
  : [
      { label: "OVERVIEW", href: "#overview" },
      { label: "CHALLENGE", href: "#challenge" },
      { label: "TECH_STACK", href: "#stack" },
      { label: "OUTCOME", href: "#outcome" }
    ];

const statusClassMap = {
  success: "text-terminal-success",
  warning: "text-terminal-warning",
  error: "text-terminal-error",
  info: "text-terminal-info"
};

const statusDotMap = {
  success: "bg-status-online",
  warning: "bg-[color-mix(in_srgb,var(--color-warning)_40%,transparent)]",
  error: "bg-[color-mix(in_srgb,var(--color-error)_40%,transparent)]",
  info: "bg-[color-mix(in_srgb,var(--color-info)_40%,transparent)]"
};

// On mobile the side rail is hidden, so the menu carries the case sections.
const menuItems = [
  { label: "Index", href: site.nav.homeHref },
  ...navItems.map((item, index) => ({ ...item, active: index === 0 }))
];

const ruHref = `/project/${caseStudy.slug}`;
const enHref = `/en/project/${caseStudy.slug}`;
---

<div class="fixed inset-0 z-0 bg-grid-pattern opacity-100 grid-bg pointer-events-none"></div>
<div class="fixed inset-0 pointer-events-none z-0">
  <div class="absolute top-8 left-8 w-6 h-6 border-l border-t border-[color-mix(in_srgb,var(--color-ochre)_40%,transparent)]"></div>
  <div class="absolute top-8 right-8 w-6 h-6 border-r border-t border-[color-mix(in_srgb,var(--color-ochre)_40%,transparent)]"></div>
  <div class="absolute bottom-8 left-8 w-6 h-6 border-l border-b border-[color-mix(in_srgb,var(--color-ochre)_40%,transparent)]"></div>
  <div class="absolute bottom-8 right-8 w-6 h-6 border-r border-b border-[color-mix(in_srgb,var(--color-ochre)_40%,transparent)]"></div>
  <div class="absolute top-0 left-12 w-[1px] h-full bg-[color-mix(in_srgb,var(--color-ochre)_5%,transparent)] hidden md:block"></div>
  <div class="absolute top-0 right-12 w-[1px] h-full bg-[color-mix(in_srgb,var(--color-ochre)_5%,transparent)] hidden md:block"></div>
</div>
<MobileMenu items={menuItems} locale={site.locale} ruHref={ruHref} enHref={enHref} />
<Header homeHref={site.nav.homeHref} links={site.nav.links} locale={site.locale} ruHref={ruHref} enHref={enHref} />
<div class="relative z-10 w-full max-w-[1800px] mx-auto min-h-screen flex flex-col md:flex-row">
  <aside class="hidden md:flex flex-col w-64 h-screen sticky top-0 pt-32 pb-12 pl-12 justify-between">
    <div class="space-y-8 border-l border-[color-mix(in_srgb,var(--color-bronze)_20%,transparent)] pl-6 relative" data-nav-rail>
      <div class="absolute -left-[1px] top-0 w-[1px] h-12 bg-bronze shadow-[0_0_10px_rgba(168,93,61,0.3)]" data-nav-indicator></div>
      <div>
        <div class="font-mono text-[11px] text-disabled tracking-widest uppercase mb-5">Navigation</div>
        <ul class="space-y-5 font-mono text-sm" data-nav-list>
          {navItems.map((item, index) => (
            <li>
              <a
                class={`nav-link block text-muted hover:text-ochre transition-colors group flex items-center gap-2 ${index === 0 ? "is-active text-ochre font-bold glowing-text" : ""}`}
                data-nav-link
                href={item.href}
              >
                <span class={`nav-bullet w-1.5 h-1.5 bg-[color-mix(in_srgb,var(--color-charcoal)_20%,transparent)] group-hover:bg-bronze transition-colors ${index === 0 ? "is-active bg-ochre shadow-[0_0_5px_rgba(217,119,6,0.8)]" : ""}`} data-nav-bullet></span>
                {String(index).padStart(2, "0")}_{item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <div class="font-mono text-[9px] text-disabled pl-6 border-l border-[color-mix(in_srgb,var(--color-bronze)_20%,transparent)]">
      <div class="mb-1 uppercase tracking-tighter">SYSTEM_STATUS</div>
      <div class="text-bronze flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-bronze animate-pulse"></span>
        ONLINE
      </div>
    </div>
  </aside>
  <main id="main-content" class="flex-1 pt-32 px-6 md:px-16 pb-32 max-w-6xl mx-auto w-full">
    <section class="mb-16 md:mb-20 relative text-center md:text-left" id="overview">
      <div class="hidden md:block absolute -top-10 left-0 w-8 h-[1px] bg-[color-mix(in_srgb,var(--color-bronze)_30%,transparent)]"></div>
      <div class="hidden md:block absolute -top-10 left-0 h-4 w-[1px] bg-[color-mix(in_srgb,var(--color-bronze)_30%,transparent)]"></div>
      <div class="inline-flex items-center gap-3 px-3 py-1 mb-8 border border-[color-mix(in_srgb,var(--color-bronze)_30%,transparent)] bg-[color-mix(in_srgb,var(--color-bronze)_5%,transparent)] text-bronze font-mono text-[10px] tracking-[0.2em] uppercase backdrop-blur-sm">
        <span class="w-1.5 h-1.5 bg-bronze rounded-sm"></span>
        {caseStudy.tag}
      </div>
      <h1 class="font-display font-light text-[11vw] md:text-7xl lg:text-8xl leading-[0.9] tracking-tighter text-charcoal mb-10 md:mb-16 select-none relative uppercase">
        {caseStudy.title}<br /><span class="text-stroke text-disabled hover:text-ochre transition-colors duration-500">{caseStudy.subtitle}</span>
        <span class="absolute -right-4 -top-4 md:right-0 md:-top-10 text-xs md:text-sm font-mono text-bronze tracking-normal opacity-80 rotate-12 border border-[color-mix(in_srgb,var(--color-bronze)_30%,transparent)] bg-badge px-2 py-1 rounded-full backdrop-blur-sm shadow-sm">{caseStudy.version}</span>
      </h1>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-y-6 gap-x-4 border-y border-[color-mix(in_srgb,var(--color-bronze)_20%,transparent)] py-8 font-mono text-sm leading-relaxed text-charcoal">
        <div class="md:border-r border-[color-mix(in_srgb,var(--color-bronze)_20%,transparent)] md:pr-4">
          <span class="text-muted block mb-1.5 text-[11px] tracking-widest uppercase">{caseStudy.roleLabel}</span>
          {caseStudy.role}
        </div>
        <div class="md:border-r border-[color-mix(in_srgb,var(--color-bronze)_20%,transparent)] md:pr-4">
          <span class="text-muted block mb-1.5 text-[11px] tracking-widest uppercase">{caseStudy.timelineLabel}</span>
          {caseStudy.timeline}
        </div>
        <div class="md:col-span-2 md:pl-4">
          <span class="text-muted block mb-1.5 text-[11px] tracking-widest uppercase">{caseStudy.deliverablesLabel}</span>
          {caseStudy.deliverables}
        </div>
      </div>
    </section>
    <section class="mb-12 md:mb-24 scroll-mt-32" id="challenge">
      <div class="technical-card p-6 md:p-10 group transition-all duration-500 hover:shadow-[0_15px_40px_rgba(168,93,61,0.08)]">
        <div>
          <div>
            <div class="font-mono text-bronze text-sm mb-4 flex items-center gap-2">
              <span class="material-symbols-outlined text-lg">crisis_alert</span>
              {caseStudy.challengeLabel}
            </div>
            <div class="h-[1px] w-12 bg-bronze mb-6"></div>
          </div>
          <div class="max-w-3xl">
            <h2 class="text-2xl md:text-3xl font-light mb-4 leading-tight text-charcoal">{caseStudy.challengeTitle}</h2>
            <p class="text-secondary leading-relaxed">
              {caseStudy.challengeBody}
            </p>
            <div class="mt-8 grid grid-cols-2 md:grid-cols-3 gap-3">
              {caseStudy.challengeMetrics.map((metric) => (
                <div class="bg-surface border border-[color-mix(in_srgb,var(--color-bronze)_10%,transparent)] p-3 backdrop-blur-md">
                  <div class="text-bronze font-display text-2xl md:text-3xl mb-1 glowing-text">{metric.value}</div>
                  <div class="font-mono text-[10px] text-muted uppercase">{metric.label}</div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
    <section class="mb-12 md:mb-24 scroll-mt-32" id="stack">
      <div class="technical-card p-5 md:p-10 bg-surface">
        <div class="font-mono text-bronze text-sm mb-8 flex items-center justify-between">
          <span>{caseStudy.stackLabel}</span>
          <span class="text-muted">[SYSTEM_ARCHITECTURE]</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 items-start gap-8">
          <div>
            <h3 class="text-2xl font-light mb-4 text-charcoal">{caseStudy.stackTitle}</h3>
            <p class="text-sm text-secondary leading-relaxed mb-6">
              {caseStudy.stackBody}
            </p>
            <ul class="flex flex-wrap gap-2 font-mono text-xs text-secondary">
              {caseStudy.stack.map((item) => (
                <li class="px-2 py-1 bg-[color-mix(in_srgb,var(--color-ink)_5%,transparent)]">{item}</li>
              ))}
            </ul>
          </div>
          <div class="min-w-0 bg-surface -mx-5 md:mx-0 px-4 py-4 md:p-6 md:rounded-sm border-y md:border-y-0 border-l-0 md:border-l-2 border-[color-mix(in_srgb,var(--color-bronze)_40%,transparent)] relative md:shadow-2xl overflow-hidden group">
            <div class="flex justify-between items-center mb-4 border-b border-[color-mix(in_srgb,var(--color-bronze)_20%,transparent)] pb-2">
              <span class="flex items-center gap-1.5 min-w-0 font-mono text-xs text-secondary">
                <span class="material-symbols-outlined text-sm text-bronze">code</span>
                <span class="truncate">{caseStudy.console.filename}</span>
              </span>
              <div class="flex shrink-0 gap-1.5">
                <div class="w-2 h-2 rounded-full bg-red-900"></div>
                <div class="w-2 h-2 rounded-full bg-yellow-900"></div>
                <div class="w-2 h-2 rounded-full bg-green-900"></div>
              </div>
            </div>
            <Code
              class="case-code max-w-full pb-2 font-mono text-sm leading-relaxed overflow-x-auto"
              code={caseStudy.console.code.trimEnd()}
              lang={caseStudy.console.languageTag ?? "plaintext"}
              themes={{ light: "github-light", dark: "github-dark" }}
              defaultColor={false}
            />
            <div class={`mt-4 flex items-center gap-2 text-xs font-mono ${statusClassMap[caseStudy.console.statusState] ?? "text-terminal-success"}`}>
              <span class={`w-1.5 h-1.5 rounded-full animate-pulse ${statusDotMap[caseStudy.console.statusState] ?? "bg-status-online"}`}></span> {caseStudy.console.statusLabel}
            </div>
          </div>
        </div>
      </div>
    </section>
    <section class="mb-20 md:mb-40 scroll-mt-32" id="outcome">
      <div class="relative pl-8 md:pl-12 border-l border-[color-mix(in_srgb,var(--color-bronze)_30%,transparent)]">
        <div class="absolute top-0 left-0 -translate-x-1/2 w-3 h-3 bg-background-dark border border-bronze rotate-45 shadow-[0_0_5px_rgba(168,93,61,0.5)]"></div>
        <div class="absolute bottom-0 left-0 -translate-x-1/2 w-3 h-3 bg-background-dark border border-bronze rotate-45 shadow-[0_0_5px_rgba(168,93,61,0.5)]"></div>
        <div class="font-mono text-bronze text-sm mb-6">{caseStudy.outcomeLabel}</div>
        {caseStudy.outcomes.length > 0 && (
          <div class="mb-16" data-carousel>
            <ul
              class="case-carousel flex gap-4 overflow-x-auto snap-x snap-mandatory pb-4 -mr-6 pr-6 md:mr-0 md:pr-0"
              aria-label={caseStudy.outcomeLabel}
              tabindex="0"
              data-carousel-track
            >
              {caseStudy.outcomes.map((item, index) => (
                <li class="technical-card snap-start shrink-0 w-[85%] md:w-[calc(50%-0.5rem)] p-6 md:p-8">
                  <div class="font-mono text-sm text-bronze mb-3">{String(index + 1).padStart(2, "0")} / {String(caseStudy.outcomes.length).padStart(2, "0")}</div>
                  <h3 class="text-xl md:text-2xl font-medium mb-3 leading-snug text-charcoal">{item.title}</h3>
                  <p class="text-base text-secondary leading-relaxed">{item.text}</p>
                </li>
              ))}
            </ul>
            {caseStudy.outcomes.length > 1 && (
              <div class="flex gap-2 mt-2">
                <button type="button" class="carousel-btn" data-carousel-prev aria-label={site.locale === "ru" ? "Предыдущее решение" : "Previous decision"}>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6" /></svg>
                </button>
                <button type="button" class="carousel-btn" data-carousel-next aria-label={site.locale === "ru" ? "Следующее решение" : "Next decision"}>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                </button>
              </div>
            )}
          </div>
        )}
        <div class="flex flex-col md:flex-row items-end gap-12">
          <div class="flex-1">
            <h2 class="text-5xl md:text-7xl font-display font-light mb-6 text-charcoal glowing-text">
              {caseStudy.outcome.metric}
            </h2>
            <h3 class="text-xl font-medium mb-4 text-charcoal">{caseStudy.outcome.title}</h3>
            <p class="text-secondary max-w-xl mb-8 leading-relaxed">
              {caseStudy.outcome.body}
            </p>
          </div>
          <div class="w-full md:w-auto pb-2">
            <a class="cta-button group relative inline-flex items-center justify-center px-8 py-4 overflow-hidden font-mono font-medium tracking-tighter bg-ochre border border-ochre transition-all duration-300 shadow-[0_0_15px_rgba(217,119,6,0.4)]" href={caseStudy.outcome.ctaHref}>
              <span class="absolute w-0 h-0 transition-all duration-500 ease-out bg-white rounded-full group-hover:w-56 group-hover:h-56 opacity-10"></span>
              <span class="relative flex items-center gap-3">
                {caseStudy.outcome.ctaLabel}
                <span class="material-symbols-outlined text-sm group-hover:translate-x-1 transition-transform">arrow_outward</span>
              </span>
            </a>
          </div>
        </div>
      </div>
    </section>
    <Footer site={site} />
  </main>
</div>

<style is:global>
  .case-code,
  .case-code span {
    color: var(--shiki-light);
    background-color: transparent !important;
  }
  .dark .case-code,
  .dark .case-code span {
    color: var(--shiki-dark);
  }
</style>
<script>
  for (const root of document.querySelectorAll("[data-carousel]")) {
    const track = root.querySelector("[data-carousel-track]");
    const prev = root.querySelector("[data-carousel-prev]");
    const next = root.querySelector("[data-carousel-next]");
    if (!track || !prev || !next) continue;
    const step = () => (track.firstElementChild?.getBoundingClientRect().width ?? track.clientWidth) + 16;
    const update = () => {
      prev.disabled = track.scrollLeft <= 1;
      next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 1;
    };
    prev.addEventListener("click", () => track.scrollBy({ left: -step() }));
    next.addEventListener("click", () => track.scrollBy({ left: step() }));
    track.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft" || event.key === "ArrowRight") {
        event.preventDefault();
        track.scrollBy({ left: event.key === "ArrowLeft" ? -step() : step() });
      }
    });
    track.addEventListener("scroll", update, { passive: true });
    update();
  }
</script>
<style is:global>
  .case-carousel { scroll-behavior: smooth; scrollbar-width: thin; scrollbar-color: color-mix(in srgb, var(--color-bronze) 40%, transparent) transparent; }
  .case-carousel:focus-visible { outline: 2px solid var(--color-ochre); outline-offset: 4px; }
  @media (prefers-reduced-motion: reduce) { .case-carousel { scroll-behavior: auto; } }
  .carousel-btn {
    display: inline-flex; align-items: center; justify-content: center;
    width: 2.75rem; height: 2.75rem;
    border: 1px solid color-mix(in srgb, var(--color-bronze) 40%, transparent);
    color: var(--color-bronze);
    transition: background-color 0.2s, opacity 0.2s;
  }
  .carousel-btn:hover:not(:disabled) { background-color: color-mix(in srgb, var(--color-bronze) 10%, transparent); }
  .carousel-btn:focus-visible { outline: 2px solid var(--color-ochre); outline-offset: 2px; }
  .carousel-btn:disabled { opacity: 0.35; cursor: default; }
  .case-code { scrollbar-width: thin; scrollbar-color: color-mix(in srgb, var(--color-bronze) 40%, transparent) transparent; }
</style>
