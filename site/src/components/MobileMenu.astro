---
const { items = [], locale = "en", ruHref = "/", enHref = "/en/" } = Astro.props;
const activeIndex = items.findIndex((item) => item.active) !== -1 ? items.findIndex((item) => item.active) : 0;
const menuTitle = locale === "ru" ? "Меню_Навигации" : "Menu_Navigation";
const altHref = locale === "ru" ? enHref : ruHref;
const altLocale = locale === "ru" ? "en" : "ru";
---

<div
  id="mobile-menu"
  class="fixed inset-0 z-[100] bg-background-dark flex flex-col overflow-y-auto overscroll-contain hidden"
  data-menu
  aria-hidden="true"
>
  <div class="fixed inset-0 z-0 menu-grid-bg pointer-events-none"></div>
  <div class="hidden md:block absolute top-6 left-6 w-4 h-4 border-l border-t border-[color-mix(in_srgb,var(--color-charcoal)_20%,transparent)] z-20"></div>
  <div class="hidden md:block absolute top-6 right-6 w-4 h-4 border-r border-t border-[color-mix(in_srgb,var(--color-charcoal)_20%,transparent)] z-20"></div>
  <div class="hidden md:block absolute bottom-6 left-6 w-4 h-4 border-l border-b border-[color-mix(in_srgb,var(--color-charcoal)_20%,transparent)] z-20"></div>
  <div class="hidden md:block absolute bottom-6 right-6 w-4 h-4 border-r border-b border-[color-mix(in_srgb,var(--color-charcoal)_20%,transparent)] z-20"></div>
  <header class="sticky top-0 z-20 shrink-0 flex justify-between items-center px-5 py-3 md:px-8 md:py-6 bg-background-dark border-b border-[color-mix(in_srgb,var(--color-charcoal)_5%,transparent)]">
    <div class="font-mono text-sm tracking-[0.2em] text-muted uppercase">
      <span class="w-2 h-2 inline-block bg-warm-amber mr-2 rounded-full animate-pulse"></span>
      {menuTitle}
    </div>
    <button
      class="w-9 h-9 md:w-10 md:h-10 border border-[color-mix(in_srgb,var(--color-charcoal)_10%,transparent)] bg-surface/30 flex items-center justify-center text-charcoal hover:bg-warm-amber hover:text-cream hover:border-warm-amber transition-all duration-300 group"
      data-menu-close
      aria-label={locale === "ru" ? "Закрыть меню" : "Close menu"}
    >
      <span class="material-symbols-outlined text-xl group-hover:rotate-90 transition-transform duration-300">close</span>
    </button>
  </header>
  <div class="flex-1 flex relative z-10 min-h-0">
    <div class="hidden md:flex w-20 border-r border-[color-mix(in_srgb,var(--color-charcoal)_5%,transparent)] flex-col justify-center items-center py-8 bg-charcoal-faint">
      <div class="vertical-text font-mono text-[10px] tracking-[0.3em] text-disabled whitespace-nowrap uppercase flex items-center gap-4">
        <span class="text-warm-amber font-bold">SYSTEM_MENU: ACTIVE</span>
        <span class="w-[1px] h-8 bg-[color-mix(in_srgb,var(--color-charcoal)_20%,transparent)]"></span>
        <span>V.2.0.4</span>
      </div>
    </div>
    <div class="flex-1 min-w-0 flex flex-col justify-center px-5 md:px-16 py-6 md:py-10">
      <nav class="flex flex-col">
        {items.map((item, index) => (
          <a
            class="group block w-full py-3 md:py-2 short:py-1.5"
            href={item.href}
            data-menu-link
            data-active={index === activeIndex ? "true" : "false"}
            aria-current={index === activeIndex ? "true" : undefined}
          >
            <div class="flex items-baseline gap-3 mb-1">
              <span class="font-mono text-sm text-warm-amber opacity-0 -translate-x-2 transition-all duration-300 group-hover:opacity-100 group-hover:translate-x-0 group-data-[active=true]:opacity-100 group-data-[active=true]:translate-x-0">
                {String(index + 1).padStart(2, "0")}
              </span>
              <span class="menu-link font-mono text-[clamp(1.875rem,9.5vw,3.75rem)] md:text-6xl short:text-4xl font-bold uppercase tracking-tighter leading-none break-words">
                {item.label}
              </span>
            </div>
            <div class="h-[1px] w-0 bg-[color-mix(in_srgb,var(--color-warm-amber)_40%,transparent)] transition-all duration-500 group-hover:w-full group-data-[active=true]:w-full"></div>
          </a>
        ))}
      </nav>
    </div>
  </div>
  <div class="relative z-20 shrink-0 border-t border-[color-mix(in_srgb,var(--color-charcoal)_5%,transparent)] px-5 py-4 md:p-6 bg-surface/30 backdrop-blur-sm">
    <div class="flex flex-col gap-4 md:gap-6">
      <div class="flex justify-between items-center">
        <div class="flex items-center gap-6">
          <div class="flex items-center bg-surface border border-[color-mix(in_srgb,var(--color-charcoal)_10%,transparent)] rounded-sm p-1">
            <a
              class={
                locale === "ru"
                  ? "px-4 py-2 text-xs font-mono font-bold bg-warm-amber text-cream rounded-sm shadow-sm transition-all"
                  : "px-4 py-2 text-xs font-mono text-muted hover:text-warm-amber transition-colors"
              }
              href={ruHref}
            >
              RU
            </a>
            <a
              class={
                locale === "en"
                  ? "px-4 py-2 text-xs font-mono font-bold bg-warm-amber text-cream rounded-sm shadow-sm transition-all"
                  : "px-4 py-2 text-xs font-mono text-muted hover:text-warm-amber transition-colors"
              }
              href={enHref}
            >
              EN
            </a>
          </div>
          <button
            class="flex items-center gap-2 px-4 py-2.5 bg-surface border border-[color-mix(in_srgb,var(--color-bronze)_20%,transparent)] rounded-sm text-bronze transition-all group"
            data-theme-toggle
            aria-label={locale === "ru" ? "Сменить тему" : "Toggle theme"}
          >
            <span class="material-symbols-outlined text-[16px] theme-light group-hover:text-bronze">dark_mode</span>
            <span class="material-symbols-outlined text-[16px] theme-dark group-hover:text-ochre">light_mode</span>
            <span class="font-mono text-[10px] uppercase tracking-wider hidden sm:inline-block" data-theme-label>Light</span>
          </button>
        </div>
      </div>
      <div class="hidden sm:flex short:hidden justify-between items-end font-mono text-[11px] text-muted uppercase tracking-wider border-t border-[color-mix(in_srgb,var(--color-charcoal)_5%,transparent)] pt-4">
        <div class="flex gap-4">
          <span>SESSION_ID: <span class="text-strong">8842-AF</span></span>
          <span class="hidden sm:inline">|</span>
          <span class="hidden sm:inline">LOC: UNKNOWN</span>
        </div>
        <div class="text-right">
          <div class="mb-1">UPTIME: <span class="text-warm-amber">99.9%</span></div>
          <div>MEM: 64MB OK</div>
        </div>
      </div>
    </div>
  </div>
</div>
